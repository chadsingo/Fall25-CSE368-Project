{
  "manifest_version": 3,
  "name": "pAIzza",
  "version": "0.1",
  "description": "Handy Piazza AI assistant for TAs",
  "icons": {
    "48": "icon.png"
  },

  "content_scripts": [
    {
      "matches": ["*://piazza.com/class/*/post/*"],
      "js": ["main.js"]
    }
  ],

  "host_permissions": [
    "http://*/",
    "http://*/*",
    "https://*/",
    "https://*/*"
  ]
}